---
import ContactForm from "../components/home/ContactForm/ContactForm.astro";
import Footer from "../components/shared/footer/Footer.astro";
import HeroSection from "../components/home/HeroSection/HeroSection.astro";
import NavBar from "../components/shared/NavBar/NavBar.astro";
import PortFolio from "../components/home/PortFolio/PortFolio.astro";
import Services from "../components/home/OurServices/Services.astro";
import Pricing from "../components/home/Pricing/Pricing.astro";
import Faq from "../components/home/Faq/Faq.astro";

import "./index.css";
import Alert from "../components/home/Alert/Alert.astro";
import Testimonial from "../components/home/Testimonial/Testimonial.astro";
import PixelBanner from "../components/home/PixelBanner/PixelBanner.astro";
import OurTeam from "../components/home/OurTeam/OurTeam.astro";

---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href="/logo.webp" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>Páginas web y sistemas a la medida para empresas | HEXALOGIC</title>
    <meta name="title" content="Páginas web y sistemas a la medida para empresas | HEXALOGIC" />
    <meta name="description" content="Desarrollamos páginas web, e-commerce y sistemas a la medida para empresas en Costa Rica y Latinoamérica." />
    <meta name="author" content="Hexalogic" />
    <meta name="keywords" content="desarrollo de software, software a medida, aplicaciones web, desarrollo web, Costa Rica, aplicaciones móviles, UX UI, branding" />
    <link rel="canonical" href="https://hexalogiccorp.com" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://hexalogiccorp.com" />
    <meta property="og:title" content="Páginas web y sistemas a la medida para empresas | HEXALOGIC" />
    <meta property="og:description" content="Desarrollamos páginas web, e-commerce y sistemas a la medida para empresas en Costa Rica y Latinoamérica." />
    <meta property="og:image" content="https://hexalogiccorp.com/socialMediaLogo.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_CR" />
    <meta property="og:site_name" content="HEXALOGIC" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://hexalogiccorp.com" />
    <meta name="twitter:title" content="Páginas web y sistemas a la medida para empresas | HEXALOGIC" />
    <meta name="twitter:description" content="Desarrollamos páginas web, e-commerce y sistemas a la medida para empresas en Costa Rica y Latinoamérica." />
    <meta name="twitter:image" content="https://hexalogiccorp.com/socialMediaLogo.png" />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": ["Organization", "ProfessionalService"],
        "name": "Hexalogic",
        "alternateName": "HEXALOGIC",
        "url": "https://hexalogiccorp.com",
        "logo": {
          "@type": "ImageObject",
          "url": "https://hexalogiccorp.com/logo.webp"
        },
        "image": "https://hexalogiccorp.com/socialMediaLogo.png",
        "description": "Desarrollamos páginas web, e-commerce y sistemas a la medida para empresas en Costa Rica y Latinoamérica, con soporte y consultoría tecnológica.",
        "email": "hexalogiccorp@gmail.com",
        "telephone": ["+50664832448", "+50685521881"],
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Limón",
          "addressCountry": "CR"
        },
        "contactPoint": {
          "@type": "ContactPoint",
          "telephone": "+50685521881",
          "contactType": "customer service",
          "availableLanguage": "Spanish"
        },
        "sameAs": [
          "https://www.facebook.com/profile.php?id=61586903368666",
          "https://www.linkedin.com/company/hexalogiccorp/",
          "https://www.instagram.com/hexalogiccorp/",
          "https://www.tiktok.com/@hexalogiccorp"
        ],
        "hasOfferCatalog": {
          "@type": "OfferCatalog",
          "name": "Servicios de Hexalogic",
          "itemListElement": [
            {
              "@type": "Offer",
              "itemOffered": {"@type": "Service", "name": "Páginas web para empresas"},
              "priceSpecification": {"@type": "PriceSpecification", "minPrice": 400, "priceCurrency": "USD"}
            },
            {
              "@type": "Offer",
              "itemOffered": {"@type": "Service", "name": "E-commerce"},
              "priceSpecification": {"@type": "PriceSpecification", "minPrice": 1200, "priceCurrency": "USD"}
            },
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Sistemas de software a la medida"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Soporte y mantenimiento"}},
            {"@type": "Offer", "itemOffered": {"@type": "Service", "name": "Consultoría tecnológica"}}
          ]
        }
      }
    </script>
    <meta name="google-site-verification" content="Vbs23HWe8G9E6YXLwUFCdQX-2hxugYUjrFZRlFl--90" />
    
  </head>
  <body>


    <NavBar />
    <HeroSection />
    <Services />
    <PortFolio/>
    <OurTeam/>
    <PixelBanner/>
    <Testimonial/>
    <Pricing />
    <Faq />
    <Alert/>
    <ContactForm/>
    <Footer />

  </body>
</html>