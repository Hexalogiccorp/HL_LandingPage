---
import "./aboutIntro.css";
import PixelGrid from "../PixelGrid/PixelGrid.astro";

const stats = [
  { value: 3, label: "Lorem" },
  { value: 9, label: "Lorem" },
  { value: 4, label: "Lorem" },
];

const statements = [
  {
    title: "Our mission",
    text: "Nuestra misión es asegurarnos de hacer tu negocio mejor a través de la tecnología de hacer tu negocio mejor a través de la tecnología.",
  },
  {
    title: "Our mission",
    text: "Nuestra misión es asegurarnos de hacer tu negocio mejor a través de la tecnología de hacer tu negocio mejor a través de la tecnología.",
  },
];
---

<section class="about-intro">
  <div class="about-intro-container">
    <h2 class="about-intro-title">About Hexalogic</h2>
    <p class="about-intro-subtitle">
      Nuestra misión es asegurarnos de hacer tu negocio mejor a través de la tecnología.
    </p>

    <div class="about-intro-body">
      <PixelGrid
        cols={6}
        rows={8}
        lightX={0.45}
        fadeRows={3}
        direction="right"
        class="about-intro-pixels"
      />

      <div class="about-intro-content">
        <p class="about-intro-text">
          Nuestra misión es asegurarnos de hacer tu negocio mejor a través de la tecnología nuestra
          misión es asegurarnos de hacer tu negocio mejor a través de la tecnología de hacer tu
          negocio mejor a través de la tecnología.
        </p>

        <ul class="about-intro-stats">
          {
            stats.map((stat) => (
              <li class="about-intro-stat">
                <span class="about-intro-stat-value">
                  +<span class="about-intro-counter" data-count={stat.value}>{stat.value}</span>
                </span>{" "}
                {stat.label}
              </li>
            ))
          }
        </ul>
      </div>

      <PixelGrid
        cols={24}
        rows={7}
        lightX={0.45}
        fadeRows={4.5}
        waveStep={0.035}
        class="about-intro-pixels-horizontal"
      />
    </div>

    <div class="about-intro-statements">
      {
        statements.map((statement, i) => (
          <article class:list={["about-intro-statement", { "about-intro-statement--right": i % 2 === 1 }]}>
            <h3 class="about-intro-statement-title">
              <span class="about-intro-statement-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path
                    d="M5 12h14M13 6l6 6-6 6"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
              {statement.title}
            </h3>
            <p class="about-intro-statement-text">{statement.text}</p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="about-intro-decoration">
    <img src="/aboutUs-decoration.png" alt="" loading="lazy" />
  </div>
</section>

<script>
  import { initAboutIntro } from "./aboutIntro";
  initAboutIntro();
</script>
