---
import "./testimonialStyle.css";
import "./testimonial.css";

// TODO: reemplazar por los testimonios reales y sus fotos
const testimonials = [
  {
    name: "Lorem Ipsum",
    role: "Lorem ipsum dolor",
    project: { name: "Lorem ipsum dolor", url: "#proyectos" },
    alliance: false,
    quote:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip.",
    image: "/testimonial%20person.png",
  },
  {
    name: "Dolor Sit",
    role: "Lorem ipsum dolor",
    project: { name: "Lorem ipsum", url: "#proyectos" },
    alliance: true,
    quote:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.",
    image: "/testimonial%20person.png",
  },
  {
    name: "Amet Consectetur",
    role: "Lorem ipsum dolor",
    project: { name: "Dolor sit amet", url: "#proyectos" },
    alliance: false,
    quote:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.",
    image: "/testimonial%20person.png",
  },
];
---

<section
  id="testimonios"
  class:list={["tst", { "tst--alliance": testimonials[0].alliance }]}
>
  <div class="tst-container">
    <h2 class="tst-title">Lorem ipsum</h2>
    <p class="tst-subtitle">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit sed do eiusmod tempor.
    </p>

    <div class="tst-body">
      <div class="tst-photo">
        {
          testimonials.map((t, i) => t.image && (
            <img
              class:list={["tst-photo-image", { "tst-active": i === 0 }]}
              src={t.image}
              alt={`Foto de ${t.name}`}
              loading="lazy"
            />
          ))
        }
      </div>

      {/* Forma de comilla que recorta la foto */}
      <svg class="tst-clip-defs" aria-hidden="true" focusable="false">
        <clipPath id="tst-photo-clip" clipPathUnits="objectBoundingBox">
          <path
            d="M0 0H1V0.516H0.371C0.371 0.686 0.653 0.824 1 0.824V1C0.448 1 0 0.733 0 0.516Z"
          ></path>
        </clipPath>
      </svg>

      <div class="tst-content">
        <div class="tst-tabs" role="tablist" aria-label="Testimonios">
          {
            testimonials.map((t, i) => (
              <button
                type="button"
                class:list={["tst-tab", { "tst-active": i === 0, "tst-tab--alliance": t.alliance }]}
                role="tab"
                aria-selected={i === 0 ? "true" : "false"}
                aria-label={`Testimonio de ${t.name}${t.alliance ? " (alianza estratégica)" : ""}`}
                data-alliance={String(t.alliance)}
              >
                {i + 1}
              </button>
            ))
          }
        </div>

        <div class="tst-card">
          <svg class="tst-quote-icon" viewBox="0 0 96 64" aria-hidden="true">
            <path d="M0 0h38v34c0 17-11 28-30 30v-14c9-2 14-7 14-16H0z" fill="currentColor"></path>
            <path d="M58 0h38v34c0 17-11 28-30 30v-14c9-2 14-7 14-16H58z" fill="currentColor"></path>
          </svg>

          <span class="tst-badge">
            <svg class="tst-badge-icon" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0l2 6 6 2-6 2-2 6-2-6-6-2 6-2z" fill="currentColor"></path>
            </svg>
            Aliado estratégico
          </span>

          <div class="tst-stack">
            {
              testimonials.map((t, i) => (
                <blockquote
                  class:list={["tst-quote", { "tst-active": i === 0 }]}
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  <p>{t.quote}</p>
                </blockquote>
              ))
            }
          </div>
        </div>

        <div class="tst-footer">
          <div class="tst-stack tst-author">
            {
              testimonials.map((t, i) => (
                <div
                  class:list={["tst-author-item", { "tst-active": i === 0 }]}
                  aria-hidden={i === 0 ? "false" : "true"}
                >
                  <p class="tst-name">{t.name}</p>
                  <p class="tst-role">{t.role}</p>
                  <p class="tst-project">
                    Proyecto:{" "}
                    <a
                      href={t.project.url}
                      class="tst-project-link"
                      tabindex={i === 0 ? undefined : "-1"}
                    >
                      {t.project.name}
                      <svg class="tst-project-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                          d="M7 17L17 7M8 7h9v9"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        ></path>
                      </svg>
                    </a>
                  </p>
                </div>
              ))
            }
          </div>

          {/* TODO: apuntar a la sección de aliados cuando exista */}
          <a href="#aliados" class="tst-allies-link">
            Ver alianzas
            <svg class="tst-allies-arrow" viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M5 12h14M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initTestimonial } from "./testimonial";
  initTestimonial();
</script>
