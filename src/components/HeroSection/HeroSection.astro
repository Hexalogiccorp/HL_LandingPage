---
import "./heroSection.css";
---

<section id="inicio" class="hero">
  <div class="hero-bg" aria-hidden="true">
    <div class="hero-bars"></div>
    <div class="hero-light">
      <div class="hero-glow hero-glow--main"></div>
      <div class="hero-glow hero-glow--top"></div>
      <div class="hero-glow hero-glow--right"></div>
    </div>
  </div>

  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">Lorem ipsum dolor sit ammet dirtu</h1>
      <p class="hero-description">
        Lorem ipsum dolor sit ammet dirtu sit <strong class="hero-highlight">portfolio</strong>
        dirtu sit ammet dirtu sit ammet dirtu
      </p>
    </div>
  </div>

  <div class="hero-infobar">
    <div class="hero-container hero-infobar-inner">
      <a href="#contactanos" class="hero-infobar-contact">
        Contact us
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 4h6v6"></path>
          <path d="M20 4l-9 9"></path>
          <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
        </svg>
      </a>

      <span class="hero-infobar-divider" aria-hidden="true"></span>

      <div class="hero-infobar-features">
        <div class="hero-infobar-feature">
          <span class="hero-infobar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24">
              <rect x="3" y="4" width="18" height="16" rx="3" fill="currentColor"></rect>
              <path d="M7.5 9.5l2.5 2.5-2.5 2.5M12 15h4.5" fill="none" stroke="#000" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <p class="hero-infobar-text">Lorem ipsum dolor sit ammet dirtu appeort</p>
        </div>

        <div class="hero-infobar-feature">
          <span class="hero-infobar-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor">
              <path d="M14 3a7 7 0 0 1 6.2 10.2l.7 3.3-3.4-.8A7 7 0 1 1 14 3z" opacity="0.55"></path>
              <path d="M8 10a5.5 5.5 0 1 1-2.6 10.3L2.5 21l.7-2.8A5.5 5.5 0 0 1 8 10z"></path>
            </svg>
          </span>
          <p class="hero-infobar-text">Lorem ipsum dolor sit ammet dirtu appeort</p>
        </div>
      </div>

      <span class="hero-infobar-divider" aria-hidden="true"></span>

      <div class="hero-infobar-social">
        <!-- TODO: agregar el enlace de LinkedIn de Hexalogic -->
        <a href="#" class="hero-infobar-social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 2H4a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM8.3 18.3H5.6V9.7h2.7v8.6zM7 8.5a1.6 1.6 0 1 1 0-3.1 1.6 1.6 0 0 1 0 3.1zm11.3 9.8h-2.7v-4.2c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2v4.3H10V9.7h2.6v1.2c.4-.7 1.2-1.4 2.6-1.4 2.7 0 3.2 1.8 3.2 4.1v4.7z"></path>
          </svg>
        </a>
        <a href="https://www.tiktok.com/@hexalogiccorp?lang=es-419" class="hero-infobar-social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.7 5.7 0 1 0 4.9 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z"></path>
          </svg>
        </a>
        <a href="https://www.instagram.com/hexalogiccorp/" class="hero-infobar-social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
            <circle cx="12" cy="12" r="4"></circle>
            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { initHeroSection } from "./heroSection";
  initHeroSection();
</script>
