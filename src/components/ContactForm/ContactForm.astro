---
import "./contactForm.css";
import PixelGrid from "../PixelGrid/PixelGrid.astro";
---

<section id="contactanos" class="contact">
  <div class="contact-container">
    <div class="contact-info">
      <h2 class="contact-title">Contact us</h2>
      <p class="contact-subtitle">
        Nuestra misión es asegurarnos de hacer tu negocio mejor a través de la tecnología.
      </p>

      <div class="contact-body">
        <ul class="contact-details">
          <li class="contact-detail">
            <span class="contact-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"></path>
              </svg>
            </span>
            <div>
              <p class="contact-detail-label">Dirección</p>
              <p class="contact-detail-value">Costa Rica y Latinoamérica</p>
            </div>
          </li>

          <li class="contact-detail">
            <span class="contact-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M20 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"></path>
              </svg>
            </span>
            <div>
              <p class="contact-detail-label">Correo</p>
              <a href="mailto:hexalogiccorp@gmail.com" class="contact-detail-value">hexalogiccorp@gmail.com</a>
            </div>
          </li>

          <li class="contact-detail">
            <span class="contact-detail-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8z"></path>
              </svg>
            </span>
            <div>
              <p class="contact-detail-label">Número de teléfono</p>
              <p class="contact-detail-value">
                <a href="tel:+50664832448">+(506) 6483-2448</a>
                <span aria-hidden="true">|</span>
                <a href="tel:+50685521881">8552-1881</a>
              </p>
            </div>
          </li>
        </ul>

        <PixelGrid
          cols={24}
          rows={7}
          lightX={0.45}
          fadeRows={4.5}
          waveStep={0.035}
          class="contact-pixels"
        />

        {/* Versión vertical: solo se muestra entre 501 y 900px */}
        <PixelGrid
          cols={8}
          rows={14}
          lightX={0.45}
          direction="left"
          class="contact-pixels-vertical"
        />
      </div>
    </div>

    <form name="contact" method="POST" data-netlify="true" netlify class="contact-form">
      <input type="hidden" name="form-name" value="contact" />

      {/* placeholder=" " permite detectar con :placeholder-shown si está vacío */}
      <div class="contact-group">
        <input id="contact-name" name="Name" type="text" placeholder=" " class="contact-field" required />
        <label for="contact-name" class="contact-label">Nombre</label>
      </div>

      <div class="contact-group">
        <input id="contact-email" name="Email" type="email" placeholder=" " class="contact-field" required />
        <label for="contact-email" class="contact-label">Correo electrónico</label>
      </div>

      <div class="contact-group">
        <input id="contact-company" name="Company" type="text" placeholder=" " class="contact-field" required />
        <label for="contact-company" class="contact-label">Nombre de la empresa</label>
      </div>

      <div class="contact-group">
        <select id="contact-service" name="service" class="contact-field contact-select" required>
          <option value="" disabled selected hidden></option>
          <option value="landing">Landing Page</option>
          <option value="website">Página Web corporativa</option>
          <option value="system">Sistema Web</option>
          <option value="other">Otro</option>
        </select>
        <label for="contact-service" class="contact-label">Me gustaría información sobre...</label>
      </div>

      <div class="contact-group contact-group--textarea">
        <textarea id="contact-message" name="message" placeholder=" " class="contact-field contact-textarea" rows="9" required></textarea>
        <label for="contact-message" class="contact-label">Mensaje</label>
      </div>

      <button type="submit" class="contact-submit">Enviar mensaje</button>
    </form>
  </div>
</section>

<script>
  import { initContactForm } from "./contactForm";
  initContactForm();
</script>
