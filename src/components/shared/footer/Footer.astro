---
import "./footer.css";

const year = new Date().getFullYear();

const WHATSAPP_MESSAGE = encodeURIComponent("Hola, me gustaría información sobre sus servicios");

const phones = [
  { label: "+(506) 8552-1881", href: `https://wa.me/50685521881?text=${WHATSAPP_MESSAGE}` },
  { label: "+(506) 6483-2448", href: `https://wa.me/50664832448?text=${WHATSAPP_MESSAGE}` },
];

const columns = [
  {
    title: "Empresa",
    links: [
      { label: "Sobre nosotros", href: "/sobre-nosotros" },
      { label: "Proyectos", href: "/#proyectos" },
      { label: "Testimonios", href: "/#testimonios" },
      { label: "Precios", href: "/#precios" },
    ],
  },
  {
    title: "Recursos",
    links: [
      { label: "Preguntas frecuentes", href: "/#faq" },
      { label: "Laboratorio de diseño", href: "/experimentos" },
      { label: "Política de privacidad", href: "/privacidad" },
      { label: "Términos y condiciones", href: "/terminos" },
    ],
  },
];
---

<footer class="footer">
  <div class="footer-glass">
    <div class="footer-container">
      <div class="footer-brand">
        <a href="/#inicio" class="footer-logo">
          <img class="footer-logo-icon" src="/greenLogo.webp" alt="" />
          <span class="footer-logo-text">HEXALOGIC</span>
        </a>
        <p class="footer-description">
          Desarrollamos páginas web y software a la medida para empresas en Costa Rica y Latinoamérica
        </p>
      </div>

      {
        columns.map((column) => (
          <div class="footer-column">
            <h3 class="footer-heading">{column.title}</h3>
            <ul class="footer-list">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="footer-column">
        <h3 class="footer-heading">Contacto</h3>
        <ul class="footer-list">
          <li class="footer-contact-item">
            <svg class="footer-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            <a href="mailto:hexalogiccorp@gmail.com" class="footer-link">hexalogiccorp@gmail.com</a>
          </li>
          <li class="footer-phones">
            {
              phones.map((phone) => (
                <div class="footer-contact-item">
                  <svg class="footer-contact-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.25-8.23 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.82c0 4.54-3.7 8.23-8.23 8.23zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.16.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28z"></path>
                  </svg>
                  <a href={phone.href} class="footer-link" target="_blank" rel="noopener noreferrer" aria-label={`WhatsApp ${phone.label}`}>{phone.label}</a>
                </div>
              ))
            }
          </li>
          <li class="footer-contact-item">
            <svg class="footer-contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span class="footer-text">Costa Rica y Latinoamérica</span>
          </li>
        </ul>

        <div class="footer-social">
          <a href="https://www.linkedin.com/company/hexalogiccorp/" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20 2H4a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM8.3 18.3H5.6V9.7h2.7v8.6zM7 8.5a1.6 1.6 0 1 1 0-3.1 1.6 1.6 0 0 1 0 3.1zm11.3 9.8h-2.7v-4.2c0-1 0-2.3-1.4-2.3s-1.6 1.1-1.6 2.2v4.3H10V9.7h2.6v1.2c.4-.7 1.2-1.4 2.6-1.4 2.7 0 3.2 1.8 3.2 4.1v4.7z"></path>
            </svg>
          </a>
          <a href="https://www.tiktok.com/@hexalogiccorp" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M16.6 5.8A4.3 4.3 0 0 1 15.5 3h-3.1v12.4a2.6 2.6 0 1 1-2.6-2.6c.3 0 .5 0 .8.1V9.7a5.7 5.7 0 1 0 4.9 5.7V9.1a7.3 7.3 0 0 0 4.3 1.4V7.4a4.3 4.3 0 0 1-3.2-1.6z"></path>
            </svg>
          </a>
          <a href="https://www.instagram.com/hexalogiccorp/" class="footer-social-link" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {year} HEXALOGIC. Todos los derechos reservados.</p>  </div>
</footer>

<script>
  import { initFooter } from "./footer";
  initFooter();
</script>
