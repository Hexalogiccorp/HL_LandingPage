---
import "./pixelGrid.css";

interface Props {
  cols: number;
  rows: number;
  /** Posición del punto de luz a lo largo del borde iluminado (0 a 1) */
  lightX?: number;
  /** Cuántas celdas desde el borde tarda en apagarse el halo del punto de luz */
  fadeRows?: number;
  /** Segundos de retraso por cada cuadro de distancia al origen de la ola */
  waveStep?: number;
  /** Desde dónde nace la luz: "up" desde abajo, "left" desde el borde derecho */
  direction?: "up" | "left";
  class?: string;
}

const {
  cols,
  rows,
  lightX = 0.45,
  fadeRows = 4.5,
  waveStep = 0.07,
  direction = "up",
  class: className,
} = Astro.props;

const isLeft = direction === "left";
const alongCount = isLeft ? rows : cols;

type RGB = [number, number, number];

const BLACK: RGB = [0, 0, 0];
const EMERALD: RGB = [52, 211, 153]; // --emerald-400
const LEMON: RGB = [135, 245, 39]; // --green-lemon
const HIGHLIGHT: RGB = [214, 236, 220];

const clamp = (v: number) => Math.min(1, Math.max(0, v));
const smoothstep = (a: number, b: number, v: number) => {
  const t = clamp((v - a) / (b - a));
  return t * t * (3 - 2 * t);
};
const mix = (a: RGB, b: RGB, t: number): RGB =>
  a.map((v, i) => Math.round(v + (b[i] - v) * t)) as RGB;
// Ruido determinístico: mismo resultado en cada build
const noise = (c: number, r: number) => {
  const s = Math.sin(c * 127.1 + r * 311.7) * 43758.5453;
  return s - Math.floor(s);
};

// Borde superior en forma de ola: [posición en el ancho, filas desde abajo]
const WAVE: [number, number][] = [
  [0, 4.4],
  [0.2, 3.4],
  [0.36, 5.7],
  [0.53, 3.6],
  [0.7, 4.6],
  [0.85, 5.5],
  [1, 6.2],
];

// Interpolación coseno: pasa suave por cada punto
const waveHeight = (x: number) => {
  const i = Math.max(0, WAVE.findIndex(([px]) => px >= x) - 1);
  const [x0, h0] = WAVE[i];
  const [x1, h1] = WAVE[Math.min(i + 1, WAVE.length - 1)];
  const t = x1 === x0 ? 0 : (x - x0) / (x1 - x0);
  return h0 + (h1 - h0) * (1 - Math.cos(t * Math.PI)) / 2;
};

const pixelColor = (c: number, r: number) => {
  // x = posición a lo largo de la ola; fromBottom = celdas desde el borde de la luz
  const x = isLeft ? r / (alongCount - 1) : c / (alongCount - 1);
  const fromBottom = isLeft ? cols - 1 - c : rows - 1 - r;
  const dx = x - lightX;

  // Fuera de la ola queda negro, difuminado en las últimas ~2 celdas
  const edge = waveHeight(x);
  const curve = 1 - smoothstep(edge - 2, edge + 0.3, fromBottom);

  // Proporcional al borde: el brillo sube con cada cresta
  const base = Math.exp(-((fromBottom / (edge * 1.1)) ** 2)) * 0.6;
  const halo = Math.exp(-((dx / 0.18) ** 2) - (fromBottom / (fadeRows * 0.8)) ** 2) * 0.4;
  const intensity = clamp((base + halo + (noise(c, r) - 0.5) * 0.06) * curve);

  const hue = mix(EMERALD, LEMON, x);
  const spot = Math.exp(-((dx / 0.06) ** 2) - (fromBottom / 1.3) ** 2);
  const color = mix(mix(BLACK, hue, intensity), HIGHLIGHT, spot * 0.85);
  return `rgb(${color.join(" ")})`;
};

const origin = isLeft
  ? { c: cols - 1, r: lightX * (rows - 1) }
  : { c: lightX * (cols - 1), r: rows - 1 };

const pixels = Array.from({ length: rows * cols }, (_, i) => {
  const c = i % cols;
  const r = Math.floor(i / cols);
  const delay = (Math.hypot(c - origin.c, r - origin.r) * waveStep).toFixed(2);
  return { color: pixelColor(c, r), delay };
});
---

<div
  class:list={["pixel-grid", className]}
  style={`--pixel-grid-cols: ${cols}; --pixel-grid-rows: ${rows}`}
  aria-hidden="true"
>
  {
    pixels.map(({ color, delay }) => (
      <span
        class="pixel-grid-pixel"
        style={`--pixel-grid-color: ${color}; --pixel-grid-delay: ${delay}s`}
      />
    ))
  }
</div>

<script>
  import { initPixelGrids } from "./pixelGrid";
  initPixelGrids();
</script>
